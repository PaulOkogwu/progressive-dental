---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import VisitBand from '../components/VisitBand.astro';
import Icon from '../components/Icon.astro';
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/img/successes/*.jpg', { eager: true });
const img = (id: string) => files[`../assets/img/successes/${id}.jpg`].default;
// Order and descriptions follow the current gallery.
const cases = [
  { id: '8687184', alt: 'Patient portrait after treatment, with close-ups of the finished smile' },
  { id: '3836070', alt: 'Before and after comparison of an upper smile, showing whiter, more even teeth' },
  { id: '3977516', alt: 'Before and after close-ups of upper front teeth restored to an even shape and shade' },
  { id: '5639954', alt: 'Patient portrait with close-ups of her smile and finished teeth' },
  { id: '8056210', alt: 'Smiling patient in glasses, with a close-up of her restored smile' },
  { id: '7732193', alt: 'Smiling patient with blonde hair showing her finished teeth' },
  { id: '6047268', alt: 'Smiling patient in glasses with a moustache' },
  { id: '7457351', alt: 'Smiling older patient with a natural-looking restored smile' },
  { id: '1484924', alt: 'Patient portrait with close-ups of her finished smile' },
  { id: '9248099', alt: 'Smiling patient in glasses, with close-ups of his restored teeth' },
  { id: '6608182', alt: 'Before and after close-ups of a smile with crowded, discoloured teeth restored' },
  { id: '2175828', alt: 'Shade matching photos and a close-up of finished upper front teeth' },
];
---
<Base title="Our Successes" description="Our successes, seen in the bright and beautiful smiles of our clients’ patients. Before-and-after cases from Progressive Dental Studio, Kitchener.">
  <PageIntro title="Our successes, seen in our clients’ patients’ smiles" lede="Beautiful smiles are what Progressive Dental Studio is all about. Seeing them on our clients’ patients makes our hard work worthwhile. Smiles are job #1 at Progressive Dental Studio." />

  <section class="section gallery-section">
    <div class="wrap">
      <ul class="gallery" data-gallery>
        {cases.map((c, i) => (
          <li data-reveal>
            <button type="button" class="tile" data-index={i} aria-label={`Open larger: ${c.alt}`}>
              <Image src={img(c.id)} alt={c.alt} widths={[360, 720]} sizes="(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 30vw" loading={i < 3 ? 'eager' : 'lazy'} />
              <span class="zoom"><Icon name="expand" /></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Smile gallery">
    <figure>
      {cases.map((c, i) => (
        <Image src={img(c.id)} alt={c.alt} data-slide={i} hidden loading="lazy" />
      ))}
      <figcaption><span class="mono" data-count></span><span data-caption></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-close aria-label="Close"><Icon name="close" /></button>
    <button type="button" class="lb-btn lb-prev" data-prev aria-label="Previous photo"><Icon name="prev" /></button>
    <button type="button" class="lb-btn lb-next" data-next aria-label="Next photo"><Icon name="next" /></button>
  </dialog>

  <VisitBand heading="Plan your next case with us" />
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const slides = [...dlg.querySelectorAll<HTMLImageElement>('[data-slide]')];
  const count = dlg.querySelector('[data-count]')!, cap = dlg.querySelector('[data-caption]')!;
  let cur = 0;
  function show(i: number) {
    cur = (i + slides.length) % slides.length;
    slides.forEach((s, j) => { s.hidden = j !== cur; if (j === cur) s.loading = 'eager'; });
    count.textContent = `${cur + 1} / ${slides.length}`;
    cap.textContent = slides[cur].alt;
  }
  document.querySelectorAll<HTMLButtonElement>('[data-gallery] .tile').forEach((b) =>
    b.addEventListener('click', () => { show(Number(b.dataset.index)); dlg.showModal(); }));
  dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(cur - 1));
  dlg.querySelector('[data-next]')!.addEventListener('click', () => show(cur + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
  let x0 = 0;
  dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); });
</script>

<style>
  .gallery { list-style: none; margin: 0; padding: 0; columns: 3 300px; column-gap: 1.5rem; }
  .gallery li { break-inside: avoid; margin-bottom: 1.5rem; }
  .tile { position: relative; display: block; width: 100%; padding: 8px; background: var(--paper); border: 1px solid var(--line); cursor: zoom-in; transition: border-color 0.25s, box-shadow 0.35s var(--ease-out), transform 0.35s var(--ease-out); }
  .tile :global(img) { width: 100%; }
  .tile:hover { border-color: var(--line-strong); box-shadow: 0 18px 36px -24px rgb(19 26 77 / 0.45); transform: translateY(-2px); }
  .zoom { position: absolute; right: 16px; bottom: 16px; width: 36px; height: 36px; display: grid; place-items: center; background: var(--navy); color: #fff; border-radius: 3px; opacity: 0; transform: translateY(4px); transition: opacity 0.25s, transform 0.3s var(--ease-out); }
  .zoom :global(svg) { width: 18px; height: 18px; }
  .tile:hover .zoom, .tile:focus-visible .zoom { opacity: 1; transform: none; }
  @media (hover: none) { .zoom { opacity: 1; transform: none; } }

  .lightbox { border: 0; padding: 0; width: min(100vw, 1100px); max-width: 100vw; max-height: 100dvh; background: transparent; overflow: visible; }
  .lightbox::backdrop { background: rgb(13 18 52 / 0.88); backdrop-filter: blur(6px); }
  .lightbox[open] { animation: lb-in 0.35s var(--ease-out); }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.98); } }
  .lightbox figure { margin: 0 auto; padding: 0 4.5rem; display: grid; justify-items: center; gap: 0.9rem; }
  .lightbox :global(img) { max-height: 80dvh; width: auto; max-width: 100%; background: var(--paper); padding: 8px; }
  .lightbox figcaption { display: flex; gap: 1rem; color: #dbe5f5; font-size: 0.9375rem; max-width: 60ch; text-align: center; }
  .lightbox figcaption .mono { color: var(--blue); white-space: nowrap; }
  .lb-btn { position: fixed; width: 48px; height: 48px; display: grid; place-items: center; background: rgb(255 255 255 / 0.12); color: #fff; border: 1px solid rgb(255 255 255 / 0.25); border-radius: 3px; cursor: pointer; transition: background-color 0.2s; }
  .lb-btn:hover { background: rgb(255 255 255 / 0.24); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 1rem; top: 50%; translate: 0 -50%; }
  .lb-next { right: 1rem; top: 50%; translate: 0 -50%; }
  @media (max-width: 640px) {
    .lightbox figure { padding: 0 0.75rem; }
    .lb-prev, .lb-next { top: auto; bottom: 1rem; translate: none; }
  }
</style>
