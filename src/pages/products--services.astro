---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import CrownViewer from '../components/CrownViewer.astro';
import VisitBand from '../components/VisitBand.astro';
import Icon from '../components/Icon.astro';
import { services, digital } from '../data/services';
const steps = [
  { key: 'Scan', title: 'Scan', text: 'Your office captures a digital impression with an intraoral scanner, such as a 3Shape TRIOS, and sends the file to the lab instead of a physical impression.' },
  { key: 'Design', title: 'Design', text: 'The restoration is designed on screen around the scan: the margin line, contours, contacts and bite.' },
  { key: 'Make', title: 'Make', text: 'The design becomes the physical restoration, then is finished and checked before it ships.' },
  { key: 'Deliver', title: 'Deliver', text: 'The finished restoration returns to your office, ready for your patient.' },
];
---
<Base title="Products & Services" description="Complete dentures, e.max and all-ceramic, PFM, Vita Easyshade, relines and repairs, Nobel Biocare CAD/CAM zirconia, full cast crowns, implants, cast partials, and a digital 3Shape workflow.">
  <PageIntro title="Products & Services" lede="Ten lines of work, made in our Kitchener lab with proven materials and systems, from complete dentures to implant rehabilitation and digital impressions." />

  <nav class="jump" aria-label="Services on this page">
    <div class="wrap jump-in">
      {[...services, digital].map((s) => <a href={`#${s.id}`}>{s.name}</a>)}
    </div>
  </nav>

  <section class="section list-section">
    <div class="wrap">
      {services.map((s) => (
        <article class="svc" id={s.id} data-reveal>
          <figure class="plate ticks"><Image src={s.img} alt={s.alt} /></figure>
          <div class="svc-body">
            <h2 class="h3">{s.name}</h2>
            {s.body.map((p) => <p>{p}</p>)}
          </div>
          <ul class="specs" aria-label={`${s.name} details`}>
            {s.specs.map((t) => <li class="callout">{t}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="digital" id={digital.id} aria-labelledby="digital-title">
    <div class="wrap">
      <div class="d-head">
        <h2 id="digital-title">{digital.name}</h2>
        <p class="lede">Digital impressions are welcome. Step through how a digital case moves from scan to finished restoration, and rotate the crown yourself.</p>
      </div>
      <div class="d-grid">
        <div class="stage sheet ticks">
          <CrownViewer mode="demo" label="Interactive 3D crown showing each step of the digital workflow" />
          <p class="badge mono">Illustrative demo</p>
        </div>
        <div class="steps" data-steps>
          <div class="tabs" role="tablist" aria-label="Digital workflow steps">
            {steps.map((s, i) => (
              <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-step={i}>
                <span class="tick" aria-hidden="true"></span>{s.key}
              </button>
            ))}
          </div>
          {steps.map((s, i) => (
            <div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
          <div class="step-nav">
            <button type="button" class="btn btn-ghost" data-prev disabled><Icon name="prev" />Back</button>
            <button type="button" class="btn btn-primary" data-next>Next step<Icon name="next" /></button>
          </div>
          <p class="note">This model is drawn in code to show how the digital workflow runs. Real case scans and videos will replace it.</p>
        </div>
      </div>
    </div>
  </section>

  <VisitBand heading="Have a case to send?" />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-steps]')!;
  const viewer = document.querySelector<HTMLElement>('[data-crown="demo"]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!, next = root.querySelector<HTMLButtonElement>('[data-next]')!;
  let cur = 0;
  function go(i: number, focus = false) {
    cur = Math.max(0, Math.min(tabs.length - 1, i));
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === cur)); t.tabIndex = j === cur ? 0 : -1; t.classList.toggle('done', j < cur); });
    panels.forEach((p, j) => { p.hidden = j !== cur; });
    if (focus) tabs[cur].focus();
    prev.disabled = cur === 0;
    next.innerHTML = cur === tabs.length - 1 ? 'Start again' : 'Next step <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
    document.dispatchEvent(new CustomEvent('crown:step', { detail: { el: viewer, step: cur } }));
  }
  tabs.forEach((t, i) => t.addEventListener('click', () => go(i)));
  root.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k === 'ArrowRight') go(cur + 1, true); else if (k === 'ArrowLeft') go(cur - 1, true);
  });
  prev.addEventListener('click', () => go(cur - 1));
  next.addEventListener('click', () => go(cur === tabs.length - 1 ? 0 : cur + 1));
  go(0);
</script>

<style>
  .jump { position: sticky; top: var(--header-h); z-index: 20; background: rgb(237 244 251 / 0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .jump-in { display: flex; flex-wrap: wrap; gap: 0.35rem; padding-block: 0.65rem; }
  @media (max-width: 760px) { .jump-in { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: thin; } }
  .jump a { flex: none; font-size: var(--fs-measure); font-weight: 520; padding: 0.4rem 0.75rem; border: 1px solid var(--line); border-radius: 2px; background: var(--paper); text-decoration: none; color: var(--text); transition: border-color 0.2s, color 0.2s; }
  .jump a:hover { border-color: var(--navy); color: var(--navy); }
  .jump a:last-child { background: var(--blue); border-color: var(--blue); color: var(--navy-ink); }
  .list-section { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .svc { display: grid; grid-template-columns: 240px minmax(0, 1fr) 260px; gap: clamp(1.5rem, 4vw, 3.5rem); padding-block: clamp(2rem, 4vw, 3rem); border-bottom: 1px solid var(--line); align-items: start; scroll-margin-top: calc(var(--header-h) + 64px); }
  .svc:first-child { padding-top: 0; }
  .plate { margin: 0; background: var(--paper); border: 1px solid var(--line); aspect-ratio: 4 / 3; display: grid; place-items: center; padding: 10px; }
  .plate :global(img) { max-width: 100%; max-height: 100%; width: auto; object-fit: contain; }
  .svc-body h2 { margin-bottom: 0.75rem; }
  .svc-body p { max-width: 60ch; color: var(--text); }
  .specs { list-style: none; margin: 0; padding: 0.25rem 0 0; display: grid; gap: 0.6rem; border-left: 1px solid var(--line-strong); padding-left: 1.25rem; }
  .specs .callout { white-space: normal; }

  .digital { padding-block: var(--section); background: linear-gradient(var(--blue), var(--blue)) top / 100% 46% no-repeat; position: relative; scroll-margin-top: calc(var(--header-h) + 50px); }
  .d-head { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 2rem; align-items: end; margin-bottom: 3.25rem; }
  .d-head h2 { color: var(--navy-ink); max-width: 13ch; }
  .d-head .lede { color: var(--navy-ink); }
  .d-grid { position: relative; display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: stretch; }
  .stage { min-height: clamp(360px, 46vw, 560px); background:
    radial-gradient(circle at 50% 48%, #fff 0 35%, transparent 72%),
    linear-gradient(var(--grid-major) 1px, transparent 1px) 0 0 / 24px 24px,
    linear-gradient(90deg, var(--grid-major) 1px, transparent 1px) 0 0 / 24px 24px, var(--paper); }
  .stage :global(.viewer) { position: absolute; inset: 0; }
  .badge { position: absolute; left: 0.9rem; top: 0.9rem; margin: 0; font-size: var(--fs-caption); background: var(--ice-2); color: var(--navy); padding: 0.3rem 0.55rem; border-radius: 2px; z-index: 2; }
  .steps { background: var(--paper); border: 1px solid var(--line); padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column; }
  .tabs { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line); margin-bottom: 1.5rem; }
  .tabs button { position: relative; display: grid; justify-items: start; gap: 0.6rem; padding: 0 0 0.9rem; background: none; border: 0; font: 600 0.9375rem var(--sans); color: var(--muted); cursor: pointer; text-align: left; }
  .tabs .tick { width: 100%; height: 3px; background: var(--ice-2); transition: background-color 0.3s; }
  .tabs button.done .tick { background: var(--blue); }
  .tabs button[aria-selected='true'] { color: var(--navy); }
  .tabs button[aria-selected='true'] .tick { background: var(--navy); }
  .tabs button:hover { color: var(--navy); }
  .panel h3 { margin-bottom: 0.6rem; }
  .panel p { color: var(--text); }
  .panel:not([hidden]) { animation: panel-in 0.45s var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(6px); } }
  .step-nav { display: flex; gap: 0.6rem; margin-top: auto; padding-top: 1.25rem; }
  .note { margin: 1.25rem 0 0; font-size: var(--fs-measure); color: var(--muted); }

  @media (max-width: 1000px) {
    .svc { grid-template-columns: 200px minmax(0, 1fr); }
    .specs { grid-column: 2; }
    .d-head, .d-grid { grid-template-columns: 1fr; }
    .digital { background-size: 100% 38%; }
  }
  @media (max-width: 640px) {
    .svc { grid-template-columns: 1fr; }
    .plate { max-width: 300px; }
    .specs { grid-column: 1; }
    .tabs button { font-size: var(--fs-measure); }
    .step-nav .btn { flex: 1; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .panel:not([hidden]) { animation: none; } }
</style>
