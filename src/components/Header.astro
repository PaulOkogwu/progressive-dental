---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav, url } from '../data/site';
const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\//, '').replace(/^index\.html$/, '');
---
<div class="strip">
  <div class="wrap strip-in">
    <span class="mono addr hide-xs"><Icon name="pin" class="i" />{site.address.street}, {site.address.city}</span>
    <span class="mono hide-sm"><Icon name="clock" class="i" />Mon–Thu 8:30–5 · Fri 8:30–2</span>
    <a class="mono" href={site.tollFree.href}>Toll free {site.tollFree.label}</a>
  </div>
</div>
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={url()} aria-label="Progressive Dental Studio Inc., home">
      <Logo />
    </a>
    <nav class="nav" aria-label="Main">
      <ul id="menu" data-menu>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="menu-contact">
          <a class="btn btn-primary" href={site.phone.href}><Icon name="phone" />Call {site.phone.label}</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
        </li>
      </ul>
    </nav>
    <a class="btn btn-primary call" href={site.phone.href}><Icon name="phone" /><span>{site.phone.label}</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <Icon name="menu" class="open" /><Icon name="close" class="shut" /><span class="sr-only">Menu</span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') btn.click();
  });
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>

<style>
  .strip { background: var(--blue); color: var(--navy-ink); }
  .strip-in { display: flex; justify-content: space-between; gap: 1rem; min-height: 34px; align-items: center; }
  .strip .mono { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--fs-caption); color: var(--navy-ink); text-decoration: none; }
  .strip a.mono:hover { text-decoration: underline; }
  .strip .addr { font-family: var(--sans); font-size: var(--fs-measure); }
  .strip :global(.i) { width: 14px; height: 14px; }

  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / 0.94); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--line); transition: box-shadow 0.3s var(--ease-out); }
  .site-header.scrolled { box-shadow: 0 8px 24px -18px rgb(19 26 77 / 0.5); }
  .bar { display: flex; align-items: center; gap: 1.5rem; height: var(--header-h); }
  .brand { width: 196px; flex: none; margin-top: -6px; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav a:not(.btn) { position: relative; display: block; padding: 0.55rem 0.7rem; font-size: var(--fs-ui); font-weight: 520; color: var(--text); text-decoration: none; border-radius: 3px; transition: color 0.2s, background-color 0.2s; }
  .nav a:not(.btn):hover { color: var(--navy); background: var(--ice); }
  /* current page: a dimension bar under the label */
  .nav a[aria-current='page'] { color: var(--navy); font-weight: 620; }
  .nav a[aria-current='page']::after { content: ''; position: absolute; left: 0.7rem; right: 0.7rem; bottom: 0.2rem; height: 7px; border-inline: 1px solid var(--navy); background: linear-gradient(var(--navy), var(--navy)) center / 100% 2px no-repeat; }
  .menu-contact { display: none; }
  .call { min-height: 42px; padding: 0.6rem 1rem; font-size: var(--fs-ui); }
  .menu-btn { display: none; }

  @media (max-width: 1100px) {
    .brand { width: 170px; }
    .nav a:not(.btn) { padding-inline: 0.5rem; font-size: var(--fs-small); }
    .nav a[aria-current='page']::after { left: 0.5rem; right: 0.5rem; }
  }
  @media (max-width: 560px) { .hide-xs { display: none !important; } }
  @media (max-width: 960px) {
    :root { --header-h: 66px; }
    .hide-sm { display: none !important; }
    .strip-in { justify-content: center; }
    .brand { width: 150px; }
    .call span { display: none; }
    .call { margin-left: auto; padding: 0; width: 46px; justify-content: center; }
    .menu-btn { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid var(--line-strong); border-radius: 3px; background: var(--paper); color: var(--navy); cursor: pointer; }
    .menu-btn :global(svg) { grid-area: 1 / 1; }
    .menu-btn :global(.shut), .menu-btn[aria-expanded='true'] :global(.open) { display: none; }
    .menu-btn[aria-expanded='true'] :global(.shut) { display: block; }
    .nav { position: absolute; top: 100%; left: 0; right: 0; margin: 0; pointer-events: none; }
    .nav ul { flex-direction: column; gap: 0; background: var(--paper); border-bottom: 1px solid var(--line); padding: 0.5rem var(--gutter) 1.25rem; box-shadow: 0 24px 40px -24px rgb(19 26 77 / 0.45); opacity: 0; transform: translateY(-8px); visibility: hidden; transition: opacity 0.25s var(--ease-out), transform 0.3s var(--ease-out), visibility 0.3s; }
    .nav ul.open { opacity: 1; transform: none; visibility: visible; pointer-events: auto; }
    .nav a:not(.btn) { padding: 0.95rem 0; font-size: var(--fs-lead-sm); border-bottom: 1px solid var(--line); border-radius: 0; }
    .nav a:not(.btn):hover { background: none; }
    .nav a[aria-current='page']::after { left: auto; right: 0; top: 50%; bottom: auto; width: 28px; translate: 0 -50%; }
    .menu-contact { display: flex; flex-direction: column; gap: 0.6rem; padding-top: 1.1rem; }
    .menu-contact .btn { justify-content: center; }
  }
</style>
