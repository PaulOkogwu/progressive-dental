---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, nav, url } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="id">
      <Logo variant="white" class="flogo" />
      <p class="tag">{site.tagline}.</p>
      <p class="since">Dental laboratory · Kitchener, Ontario · since 1999</p>
    </div>
    <div>
      <h2 class="fh">Visit</h2>
      <address>
        {site.address.street}<br />{site.address.city}, {site.address.region}<br />{site.address.postal}
      </address>
      <p class="small">{site.landmark}</p>
    </div>
    <div>
      <h2 class="fh">Call or email</h2>
      <ul class="lines">
        <li><Icon name="phone" /><a href={site.phone.href}>{site.phone.label}</a></li>
        <li><Icon name="phone" /><a href={site.tollFree.href}>{site.tollFree.label}</a> <span class="small">toll free</span></li>
        <li><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="fh">Hours</h2>
      <dl class="hours">
        {site.hours.map((h) => (<div><dt>{h.days}</dt><dd>{h.time}</dd></div>))}
      </dl>
    </div>
  </div>
  <div class="wrap base">
    <nav aria-label="Footer">
      {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    </nav>
    <p class="mono">© {year} {site.name}</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy-ink); color: var(--on-navy); padding-top: clamp(3.5rem, 7vw, 5.5rem); position: relative; overflow: hidden; }
  .grid { position: relative; display: grid; grid-template-columns: 1.4fr 1fr 1.1fr 1.1fr; gap: 2.5rem; padding-bottom: 3rem; }
  .flogo { width: 230px; margin-bottom: 1.25rem; }
  .tag { font-family: var(--display); font-stretch: 112%; font-size: var(--fs-tag); font-weight: 600; color: #fff; line-height: 1.25; max-width: 22ch; }
  .since { color: var(--blue); font-size: var(--fs-caption); }
  .fh { font-family: var(--mono); font-stretch: normal; font-size: var(--fs-caption); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid rgb(141 182 224 / 0.3); }
  address { font-style: normal; color: #fff; line-height: 1.6; margin-bottom: 0.75rem; }
  .small { font-size: var(--fs-small); color: var(--on-navy-muted); }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .lines li { display: flex; align-items: center; gap: 0.6rem; }
  .lines :global(svg) { width: 17px; height: 17px; color: var(--blue); flex: none; }
  .site-footer a { color: #fff; text-decoration-color: rgb(141 182 224 / 0.6); }
  .hours { margin: 0; display: grid; gap: 0.55rem; }
  .hours div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px dashed rgb(141 182 224 / 0.25); padding-bottom: 0.45rem; }
  .hours dt { color: var(--on-navy-muted); font-size: var(--fs-ui); }
  .hours dd { margin: 0; color: #fff; font-family: var(--mono); font-size: var(--fs-measure); white-space: nowrap; }
  .base { position: relative; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-block: 1.5rem 2rem; border-top: 1px solid rgb(141 182 224 / 0.25); }
  .base nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  .base nav a { font-size: var(--fs-small); text-decoration: none; color: var(--on-navy-link); }
  .base nav a:hover { color: #fff; text-decoration: underline; }
  .base .mono { margin: 0; color: var(--on-navy-faint); font-size: var(--fs-caption); }
  .site-footer ::selection { background: var(--blue); color: var(--navy-ink); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } .id { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
