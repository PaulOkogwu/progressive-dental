---
import Icon from './Icon.astro';
import MapEmbed from './MapEmbed.astro';
import { site } from '../data/site';
interface Props { heading?: string; map?: boolean }
const { heading = 'Talk to the lab', map = false } = Astro.props;
---
<section class="section visit">
  <div class="wrap">
    <div class:list={['visit-sheet sheet ticks', { 'with-map': map }]} data-reveal>
      <div class="v-main">
        <h2>{heading}</h2>
        <p class="lede">Call, email, or drop in at the lab in downtown Kitchener. We’re at Queen and Weber, across from the Kitchener Main Public Library.</p>
        <div class="actions">
          <a class="btn btn-primary" href={site.phone.href}><Icon name="phone" />Call {site.phone.label}</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}><Icon name="mail" />Email the lab</a>
        </div>
      </div>
      <dl class="v-facts">
        <div><dt class="mono">Address</dt><dd>{site.address.street}<br />{site.address.city}, {site.address.region}<br />{site.address.postal}</dd></div>
        <div><dt class="mono">Phone</dt><dd><a href={site.phone.href}>{site.phone.label}</a><br /><a href={site.tollFree.href}>{site.tollFree.label}</a> <span class="muted">toll free</span></dd></div>
        <div><dt class="mono">Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt class="mono">Hours</dt><dd>{site.hours.slice(0, 2).map((h) => (<span class="hr"><span>{h.days}</span><span class="mono">{h.time}</span></span>))}</dd></div>
      </dl>
      {map && <MapEmbed class="v-map" />}
    </div>
  </div>
</section>
<style>
  .visit-sheet { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); padding: clamp(1.75rem, 5vw, 3.75rem); }
  .v-main h2 { margin-bottom: 1rem; }
  .v-main .lede { margin-bottom: 1.75rem; }
  .v-facts { margin: 0; display: grid; gap: 0; align-content: start; }
  .v-facts > div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding-block: 0.95rem; border-bottom: 1px solid var(--line); }
  .v-facts > div:first-child { border-top: 1px solid var(--line); }
  .v-facts dt { color: var(--blue-ink); font-size: 0.75rem; padding-top: 0.2rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .v-facts dd { margin: 0; }
  .muted { color: var(--muted); font-size: 0.875rem; }
  .hr { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem 1rem; align-items: baseline; }
  .hr + .hr { margin-top: 0.35rem; }
  .hr .mono { color: var(--muted); }
  .with-map :global(.v-map) { grid-column: 1 / -1; }
  @media (max-width: 860px) { .visit-sheet { grid-template-columns: 1fr; } .v-facts > div { grid-template-columns: 5rem 1fr; } }
  @media (max-width: 480px) { .hr { grid-template-columns: 1fr; gap: 0; } .hr + .hr { margin-top: 0.6rem; } }
</style>
