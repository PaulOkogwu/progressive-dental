---
interface Props { title: string; lede?: string }
const { title, lede } = Astro.props;
---
<section class="intro">
  <div class="wrap intro-grid">
    <div>
      <h1 class="page-title">{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <div class="aside"><slot /></div>
  </div>
</section>
<style>
  .intro { padding-block: clamp(2.75rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); border-bottom: 1px solid var(--line); }
  .intro-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: end; }
  .page-title { font-size: clamp(2.4rem, 5.4vw, 4.4rem); font-weight: 680; line-height: 1; letter-spacing: -0.03em; max-width: 16ch; margin-bottom: 1.25rem; }
  .lede { margin: 0; }
  .aside:empty { display: none; }
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr; } }
</style>
